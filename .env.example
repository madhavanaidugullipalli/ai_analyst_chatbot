# LLM provider: gemini | ollama | none  (gemini is the active default)
LLM_PROVIDER=gemini

# Gemini (hosted) — required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ollama (optional / local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# App limits
MAX_UPLOAD_MB=25
QUERY_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=10000
MAX_SQL_ATTEMPTS=3
DUCKDB_PATH=:memory:

# Auth / workspaces
AUTH_ENABLED=true
ALLOW_GUEST_MODE=true
SESSION_SECRET=change-me-in-production
DEFAULT_WORKSPACE_NAME=Personal
# APP_DB_URL=sqlite:///./data/app.db

# Optional Postgres analytical source
POSTGRES_ENABLED=false
POSTGRES_DSN=postgresql://user:password@localhost:5432/analytics
